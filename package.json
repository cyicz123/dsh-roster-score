{
  "name": "dsh-roster-score",
  "version": "0.1.0",
  "private": true,
  "description": "拖入学生花名册，念名字、听成绩、自动回读，最后一键导出带成绩的新表。",
  "license": "Apache-2.0",
  "author": "cyicz123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyicz123/dsh-roster-score.git"
  },
  "homepage": "https://github.com/cyicz123/dsh-roster-score#readme",
  "bugs": {
    "url": "https://github.com/cyicz123/dsh-roster-score/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "roster",
    "speech",
    "education"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
